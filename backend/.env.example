# PulsePipe — backend/.env example
# Copy to backend/.env (loaded automatically by app/config.py) or export in
# the process environment — real env vars always win over this file.
# Placeholders only; never commit real values. Reference: docs/env-config.md

# App identity (reported by /api/health)
# PULSEPIPE_NAME=PulsePipe
# PULSEPIPE_VERSION=1.0.0

# ASGI bind for `python main.py` (uvicorn CLI flags override these)
# PULSEPIPE_HOST=0.0.0.0
# PULSEPIPE_PORT=8000
# PULSEPIPE_DEBUG=false        # true → uvicorn --reload

# SQLite database — use an ABSOLUTE path on persistent storage in production
# (default: <project root>/data/pulsepipe.db)
# PULSEPIPE_DB_PATH=/var/lib/pulsepipe/pulsepipe.db

# Seed demo pipelines/events/rules on first boot (set false in production
# after the first boot)
# PULSEPIPE_SEED_ON_START=true

# Subscriber dispatch: sync (deliver inside the ingest request) or
# async/background (deliver on a worker thread)
# PULSEPIPE_DISPATCH_MODE=sync
# PULSEPIPE_DISPATCH_TIMEOUT=2.0   # seconds per subscriber HTTP call
