# PulsePipe — .env example
# Copy to .env (backend/). Never commit real values.

PULSEPIPE_NAME=PulsePipe
PULSEPIPE_VERSION=1.0.0
PULSEPIPE_HOST=0.0.0.0
PULSEPIPE_PORT=8000
PULSEPIPE_DEBUG=false

# SQLite database file (defaults to backend/data/pulsepipe.db)
PULSEPIPE_DB_PATH=

# Seed sample pipelines/events/rules on first boot (set 0 in production)
PULSEPIPE_SEED_ON_START=true

# Event dispatch: "sync" (deterministic, inline) or "async" (background worker)
PULSEPIPE_DISPATCH_MODE=sync
PULSEPIPE_DISPATCH_TIMEOUT=2.0
